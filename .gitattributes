# The installers are run with sh on Linux and macOS. If core.autocrlf rewrites them to
# CRLF on checkout, `curl | sh` dies on a stray \r, so line endings are pinned here.
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.spec text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

*.ps1 text eol=crlf
